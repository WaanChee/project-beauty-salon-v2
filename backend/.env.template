# ============================================================================
# BACKEND ENVIRONMENT VARIABLES (Render-compatible)
# ============================================================================

# ============================================================================
# NEON POSTGRESQL DATABASE CONNECTION
# ============================================================================
# Get this from your Neon Dashboard: https://console.neon.tech
# Format: postgresql://username:password@hostname/database?sslmode=require
DATABASE_URL=postgresql://username:password@ep-xxx-xxx.region.aws.neon.tech/dbname?sslmode=require

# ============================================================================
# JWT SECRET KEY
# ============================================================================
# Generate a secure random string (at least 32 characters)
# You can use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=your-super-secret-jwt-key-minimum-32-characters-long

# ============================================================================
# FIREBASE ADMIN SERVICE ACCOUNT
# ============================================================================
# Option A: Full JSON service account in one env var
#   - Use FIREBASE_SERVICE_ACCOUNT with valid JSON or escaped newlines
#   - Example: {"type":"service_account", ... "private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n", ...}
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# Option B: Use separate Firebase environment variables
#   - FIREBASE_PRIVATE_KEY (escaped `\n` retained)
#   - FIREBASE_CLIENT_EMAIL
#   - FIREBASE_PROJECT_ID
#   Example:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# FIREBASE_PROJECT_ID=your-project-id

# ============================================================================
# PORT (Render sets this automatically)
# ============================================================================
# Render assigns PORT automatically, so you do not need to set it manually.

# ============================================================================
# FRONTEND URL FOR CORS
# ============================================================================
# Add your deployed frontend URL here.
# If you have multiple frontend domains, separate them with commas.
FRONTEND_URL=https://your-app.onrender.com

# ============================================================================
# INSTRUCTIONS FOR REPLIT SECRETS:
# ============================================================================
# 1. In Replit, click the "Secrets" tab (lock icon on left sidebar)
# 2. Add each variable as a separate secret:
#    - Key: DATABASE_URL
#    - Value: Your Neon PostgreSQL connection string
# 3. Repeat for all variables above
# 4. DO NOT commit .env file to Git (it's in .gitignore)
